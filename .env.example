# Postgres (Docker compose default is host port 5433; your local install may use 5432)
DATABASE_URL=postgresql+psycopg://bis:bis@localhost:5433/bis_recommend

# --- Optional: only needed for cloud LLM extraction (extraction_mode=llm) ---
# Leave empty for the demo path: keyword tagger + local embeddings (works offline after model cache).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Optional: only needed for live Bhashini translation (translation_mode=bhashini) ---
# Without these, Hindi/Tamil use demo_phrases.json or return untranslated with a warning.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# Frontend (dashboard only; extension API URL is set in the Chrome popup)
# VITE_API_BASE_URL=http://127.0.0.1:8000
